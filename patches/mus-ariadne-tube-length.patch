+    /// Section lengths at `point` for tubes with a `TubeLength` term (the
+    /// others keep their compiled `dx`), and the column halves that use them.
+    fn apply_lengths(&mut self, point: &[f64]) -> Result<(), NetworkError> {
+        let mut changed = false;
+        for term in &self.spec.area_terms {
+            if let AreaTermSpec::TubeLength { tube, length_m } = term {
+                let length = length_m.eval(point);
+                if !length.is_finite() || length <= 0.0 {
+                    return Err(NetworkError::NonFiniteGeometry);
+                }
+                self.dx[*tube] = length / self.spec.tubes[*tube].base_log_area_m2.len() as f64;
+                changed = true;
+            }
+        }
+        if changed {
+            for element in &mut self.elements {
+                let tube_a = self.node_tube[element.a];
+                match element.b {
+                    None => element.half_a = 0.5 * self.dx[tube_a],
+                    Some(b) if self.node_tube[b] == tube_a => {
+                        element.half_a = 0.5 * self.dx[tube_a];
+                        element.half_b = element.half_a;
+                    }
+                    Some(b) => element.half_b = 0.5 * self.dx[self.node_tube[b]],
+                }
+            }
+        }
+        Ok(())
+    }
