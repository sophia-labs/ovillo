{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sophia.invalid/schemas/ariadne-metric-radiation-v1.schema.json",
  "title": "Ariadne finite-rank metric radiation plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "fraction", "rows"],
  "properties": {
    "schema_version": {"const": "ariadne-metric-radiation-v1"},
    "id": {"type": "string", "minLength": 1},
    "fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "number"}
      }
    }
  }
}
