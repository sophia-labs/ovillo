#   kk = tumba (perc, voice=buzz, st=-14->-22, curve=exp, tau=0.05, lpf=320, rel=0.12, duck=0, gain=-7)
#   gu = guiro (perc, voice=car, hpf=2000, lpf=9000, rel=0.05, gain=-17)
#   tb = timbal (perc, voice=car, hpf=800, lpf=6500, rel=0.07, gain=-11)
#   bs = contrabajo (bass, synth=pluck, bodyp=bass, sus=1.4, damp=0.3, pick=0.5, pos=0.25, body=0.9, body_size=1.25, gain=1, send=0.05)
#   mt = tres (treble, synth=pluck, bodyp=guitar, sus=1.1, damp=0.4, pick=0.85, pos=0.11, body=0.6, gain=-4, send=0.12)
#   sx = saxofones (treble, synth=weave, bodyp=cello, breath=0.35, bow=0.35, bow_speed=0.55, sus=2.2, damp=0.3, courses=7, couple=0.08, body=0.7, gain=-4, send=0.2)
#   br = metales (treble, synth=saw, detune=12, sub=0.15, cutoff=2600, satk=0.004, sdec=0.3, ssus=0.5, srel=0.06, dist=1.3, gain=-6, send=0.15)
