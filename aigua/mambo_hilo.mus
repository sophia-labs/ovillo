#   gu = maracas (perc, synth=weave, breath=1, sus=0.15, damp=0.6, courses=5, couple=0, body=0.2, gain=-15, send=0.05)
#   tb = timbal (perc, synth=pluck, buzz=0.6, sus=0.2, damp=0.6, pick=0.9, pos=0.1, body=0.6, gain=-9, send=0.1)
#   bs = contrabajo (bass, synth=pluck, bodyp=bass, sus=1.4, damp=0.3, pick=0.5, pos=0.25, body=0.9, body_size=1.25, gain=1, send=0.05)
