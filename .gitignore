__pycache__/
*.pyc
.venv/
.uv-cache/
.DS_Store

# Local test fixtures and outputs — not part of the published repo
*.mid
*.midi
*.musicxml
*.xml
*.mxl
*.mus
_make_test_*.py

# ...but the Aigua worked example ships its scores and its round-trip output.
!aigua/*.mus
!aigua/render/aigua_score.musicxml

# ...and WF9's self-contained fast-subset fixture (mus-cli/tests/
# parity_expectations.rs) ships its score too, same reasoning.
!mus-rs/crates/mus-cli/tests/fixtures/wf9_offline/*.mus

# ...and the annotated-tab examples (SPEC-TAB.md): the steel-string acceptance
# score (mus-cli/tests/ariadne_tab.rs) and the first full piece.
!examples/tab/*.mus
examples/tab/out/

# ...and the Ariadne piano's demo and gate probes (SPEC-ARIADNE-PIANO.md).
!examples/piano/*.mus

# ...and the scores written for ovillo.sophia-labs.com (site/README.md).
!site/scores/*.mus

# Derived audio. The source recording (aigua/source/) and the extracted sample
# instrument (aigua/samples/) are committed; everything below is regenerated by
# the pipeline in aigua/README.md and is too large to be worth versioning.
aigua/*.wav
aigua/recon_cache.npy
aigua/render/*.wav

# The research object is an immutable local materialization regenerated from
# committed source artifacts and authored contracts. Large v2 experiment
# outputs remain local until the Garden array-artifact policy is ratified.
aigua/research-object/
aigua/v2/*.json
aigua/v2/*.npy
aigua/v2/*.npz
aigua/render/*.html
# Ariadne Phase 2 §C stimuli. Regenerated exactly by
# `cargo run -p mus-dsp --release --example phase2_same_endpoint`; the
# generator and `.string-research/PHASE2-REPORT.md` are committed, the seven
# WAVs and the two receipts are not. Same reasoning as the aigua renders
# above: derived audio, reproducible from committed source.
.string-research/phase2-stimuli/

*.egg-info/
formal/.lake/
paper/ariadne-protected-nonabelian/fantasmas/
paper/ariadne-protected-nonabelian/fantasmas-tejido/
paper/ariadne-protected-nonabelian/pizzicato/
threader-bank-v0/
paper/ariadne-protected-nonabelian/cantora/
paper/ariadne-protected-nonabelian/mambo-hilo/
paper/ariadne-protected-nonabelian/garganta-humana/

# Local plug-in bundles, validation logs, public-audio audition renders, and
# release archives. Their generators/receipts are committed; binaries and WAVs
# remain handoff artifacts rather than repository history.
artifacts/
